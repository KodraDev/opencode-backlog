{
  "name": "kodradev-opencode-backlog",
  "version": "0.1.2",
  "description": "SQLite-backed hybrid project/session backlog tools and sidebar for OpenCode 2",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KodraDev/opencode-backlog.git"
  },
  "bugs": {
    "url": "https://github.com/KodraDev/opencode-backlog/issues"
  },
  "homepage": "https://github.com/KodraDev/opencode-backlog#readme",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node script/build-tui.mjs",
    "dev": "node script/dev.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "typecheck:src": "tsc -p tsconfig.build.json --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "backlog",
    "kanban"
  ],
  "license": "MIT",
  "overrides": {
    "seroval": "1.6.8",
    "brace-expansion@2": "2.1.7"
  },
  "dependencies": {
    "@opencode/client": "2.0.23",
    "@opencode/plugin": "2.0.23",
    "proper-lockfile": "^4.1.2"
  },
  "peerDependencies": {
    "@opentui/solid": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.0.23",
    "@opentui/solid": "0.5.14",
    "@types/bun": "1.4.2",
    "@types/node": "24.3.0",
    "@types/proper-lockfile": "^4.1.4",
    "solid-js": "1.9.12",
    "typescript": "5.8.2"
  }
}
